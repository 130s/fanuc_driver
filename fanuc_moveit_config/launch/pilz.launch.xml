<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <let name="_share_path" value="$(find-pkg-share fanuc_moveit_config)" />

  <arg name="robot_ip" default="192.168.1.100" />
  <arg name="rviz_conf_path" default="$(var _share_path)/config/view_robot.rviz"
       description="RViz configuration file full path" />
  <arg name="use_fake_hardware" default="true" />
  <arg name="robot_description_string"
       default="$(command 'xacro $(find-pkg-share fanuc_hardware_interface)/robot/crx30ia.urdf.xacro robot_ip:=$(var robot_ip)')" />
  <arg name="srdf_file_path" default="$(var _share_path)/config/crx30ia.srdf" />

  <node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" output="log"
        args="--frame-id world --child-frame-id base_link" />

  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="both">
    <param name="robot_description" value="$(var robot_description_string)" />
  </node>

  <node pkg="moveit_ros_move_group" exec="move_group" output="screen">
    <param name="robot_description" value="$(var robot_description_string)" />
    <param from="$(var srdf_file_path)" />
    <param name="publish_robot_description" value="True" />
    <param name="publish_robot_description_semantic" value="True" />

    <param from="$(var _share_path)/config/kinematics.yaml" />
    <param from="$(var _share_path)/config/joint_limits.yaml" />
    <param from="$(var _share_path)/config/moveit_controllers.yaml" />
    <param from="$(var _share_path)/config/ompl_planning.yaml" />
    <param from="$(var _share_path)/config/pilz_planner.yaml" />

    <param name="capabilities"
           value="pilz_industrial_motion_planner/MoveGroupSequenceAction pilz_industrial_motion_planner/MoveGroupSequenceService" />
  </node>

  <node pkg="controller_manager" exec="ros2_control_node" output="both">
    <param name="robot_description" value="$(var robot_description_string)" />
    <param from="$(var _share_path)/config/ros2_controllers.yaml" />
    <remap from="/controller_manager/robot_description" to="/robot_description" />
  </node>

  <node pkg="controller_manager" exec="spawner" name="joint_state_broadcaster_spawner"
        args="joint_state_broadcaster --controller-manager /controller_manager" output="screen" />
  <node pkg="controller_manager" exec="spawner" name="arm_controller_spawner"
        args="joint_trajectory_controller -c /controller_manager" output="screen" />
  <node pkg="controller_manager" exec="spawner" name="hand_controller_spawner"
        args="robotiq_gripper_controller -c /controller_manager" output="screen" />

  <node pkg="rviz2" exec="rviz2" output="log" args="-d $(var rviz_conf_path)">
    <param name="robot_description" value="$(var robot_description_string)" />
    <param from="$(var srdf_file_path)" />
    <param from="$(var _share_path)/config/kinematics.yaml" />
    <param from="$(var _share_path)/config/joint_limits.yaml" />
    <param from="$(var _share_path)/config/pilz_planner.yaml" />
  </node>
</launch>
