<package format="3">
  <name>fanuc_hardware_interface</name>
  <version>2.1.0</version>
  <description>
    ROS 2 control streaming driver for FANUC robots.
  </description>
  <license>Apache-2.0</license>
  <maintainer email="fanuc-ros-maintainer@fanuc.co.jp">FANUC CORPORATION</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>fanuc_libs</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>controller_manager</exec_depend>

  <exec_depend>fanuc_crx_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slider_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
