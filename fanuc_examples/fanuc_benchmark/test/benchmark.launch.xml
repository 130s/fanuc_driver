<!--
  SPDX-FileCopyrightText: 2026, FANUC America Corporation
  SPDX-FileCopyrightText: 2026, FANUC CORPORATION
  SPDX-License-Identifier: Apache-2.0

  Entry point for the FANUC motion-planner benchmark.

  This file does everything that launch-XML can express:
    1. brings up the selected planner's move_group + FANUC driver,
    2. records a rosbag of planned vs. actual joints and speed scaling,
    3. starts the motion-task runner (via a tiny .py helper that builds the
       MoveIt configuration - the one piece that cannot be expressed in XML).

  Select the planner with the `planner` argument. Because OMPL/MTC and Pilz need
  different move_group pipelines and joint-limit files, set those together:

    OMPL (default):
      ros2 launch fanuc_benchmark benchmark.launch.xml robot_ip:=192.168.120.101

    Pilz LIN (joint_limits_file is the pilz_joint_limits.yaml from
    fanuc_moveit_config; give its absolute path):
      ros2 launch fanuc_benchmark benchmark.launch.xml
        planner:=pilz_lin
        planning_pipeline:=pilz_industrial_motion_planner
        joint_limits_file:=/path/to/fanuc_moveit_config/config/pilz_joint_limits.yaml

    MoveIt Task Constructor:
      ros2 launch fanuc_benchmark benchmark.launch.xml planner:=mtc

  If you already have move_group running (e.g. via fanuc_moveit.launch.py), pass
  launch_moveit:=false to only run the motion-task node + recording.
-->
<launch>
  <!-- Robot / hardware -->
  <arg name="robot_model" default="crx30ia" description="FANUC CRX model."/>
  <arg name="robot_ip" default="192.168.120.101" description="The robot's IP address."/>

  <!-- Planner selection -->
  <arg name="planner" default="ompl" description="Benchmark back-end: ompl | pilz_lin | mtc."/>
  <arg name="planning_pipeline" default="ompl"
       description="move_group pipeline. Use pilz_industrial_motion_planner for planner:=pilz_lin."/>
  <arg name="joint_limits_file"
       default="$(find-pkg-share fanuc_moveit_config)/config/joint_limits.yaml"
       description="Joint limits YAML. Use config/pilz_joint_limits.yaml for planner:=pilz_lin."/>
  <arg name="planner_id" default="" description="Optional planner id override (Pilz defaults to LIN)."/>
  <arg name="group" default="manipulator" description="Planning group."/>

  <!-- MTC-specific -->
  <arg name="mtc_solver" default="pipeline" description="MTC solver: pipeline | interpolation."/>
  <arg name="mtc_pipeline" default="ompl" description="Underlying pipeline for the MTC pipeline solver."/>

  <!-- Run options -->
  <arg name="iterations" default="3" description="Number of forward+reverse MOTR repetitions."/>
  <arg name="velocity_scaling" default="0.1" description="Max velocity scaling factor (0-1)."/>
  <arg name="acceleration_scaling" default="0.1" description="Max acceleration scaling factor (0-1)."/>
  <arg name="planning_time" default="5.0" description="Planning time budget per request (s)."/>
  <arg name="planning_attempts" default="10" description="Planning attempts per request."/>
  <arg name="state_wait_timeout" default="30.0"
       description="Abort if the current robot state is not obtained within this many seconds."/>
  <arg name="poses_file"
       default="$(find-pkg-share fanuc_benchmark)/test/benchmark_poses.yaml"
       description="Waypoint definition file."/>

  <!-- Orchestration -->
  <arg name="launch_moveit" default="true" description="Also bring up move_group + the FANUC driver."/>
  <arg name="launch_rviz" default="true" description="Launch RViz with move_group."/>
  <arg name="record_bag" default="true" description="Record a rosbag of the run."/>
  <arg name="stmo_recovery" default="true" description="Watch for STMO inactive warnings and issue the recovery service call."/>
  <arg name="output_dir" default="$(env PWD)" description="Directory for the recorded bag."/>
  <arg name="timestamp" default="$(command 'date +%Y%m%d_%H%M%S')"
       description="Evaluated once; used as the bag name suffix (benchmark_%TIMESTAMP%)."/>

  <!-- 1. Bring up the selected planner's move_group + FANUC driver. -->
  <include file="$(find-pkg-share fanuc_moveit_config)/launch/fanuc_moveit.launch.py" if="$(var launch_moveit)">
    <arg name="robot_model" value="$(var robot_model)"/>
    <arg name="robot_ip" value="$(var robot_ip)"/>
    <arg name="planning_pipeline" value="$(var planning_pipeline)"/>
    <arg name="joint_limits_file" value="$(var joint_limits_file)"/>
    <arg name="launch_rviz" value="$(var launch_rviz)"/>
  </include>

  <!-- 2. Watch the controller output for STMO inactive warnings and trigger the
          recovery service call. If the workaround fails to restore motion_possible,
          the watcher exits non-zero and on_exit="shutdown" tears down the whole
          benchmark (move_group, driver, rosbag and the motion-task runner). -->
  <executable
    cmd="python3 $(find-pkg-share fanuc_benchmark)/test/stmo_recovery.py"
    output="screen"
    on_exit="shutdown"
    if="$(var stmo_recovery)"/>

  <!-- 3. Record planned (controller_state.reference) vs. actual
          (controller_state.feedback / joint_states) joints, the collaborative
          speed scaling, and the per-MOTR timing messages. -->
  <executable
    cmd="ros2 bag record -o $(var output_dir)/benchmark_$(var timestamp) /motion_task_test/motr_result /joint_states /joint_trajectory_controller/controller_state /fanuc_gpio_controller/collaborative_speed_scaling /display_planned_path"
    output="screen"
    if="$(var record_bag)"/>

  <!-- 4. Motion-task runner (built with the full MoveIt config via the .py helper). -->
  <include file="$(find-pkg-share fanuc_benchmark)/test/motion_task_test.launch.py">
    <arg name="robot_model" value="$(var robot_model)"/>
    <arg name="robot_ip" value="$(var robot_ip)"/>
    <arg name="planner" value="$(var planner)"/>
    <arg name="group" value="$(var group)"/>
    <arg name="planner_id" value="$(var planner_id)"/>
    <arg name="planning_pipeline" value="$(var planning_pipeline)"/>
    <arg name="joint_limits_file" value="$(var joint_limits_file)"/>
    <arg name="iterations" value="$(var iterations)"/>
    <arg name="velocity_scaling" value="$(var velocity_scaling)"/>
    <arg name="acceleration_scaling" value="$(var acceleration_scaling)"/>
    <arg name="planning_time" value="$(var planning_time)"/>
    <arg name="planning_attempts" value="$(var planning_attempts)"/>
    <arg name="state_wait_timeout" value="$(var state_wait_timeout)"/>
    <arg name="mtc_solver" value="$(var mtc_solver)"/>
    <arg name="mtc_pipeline" value="$(var mtc_pipeline)"/>
    <arg name="poses_file" value="$(var poses_file)"/>
  </include>
</launch>
